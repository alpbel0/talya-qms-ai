# Bu dosyayı ".env" olarak kopyalayın ve değerleri kendi ortamınıza göre değiştirin.
#   Linux/macOS : cp .env.example .env
#   PowerShell  : Copy-Item .env.example .env
# ".env" dosyası .gitignore ile korunur; ASLA commit'lenmez.
# Aşağıdakiler yalnızca ÖRNEK değerlerdir, gerçek sır değildir.

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=degistir-beni-ornek-parola
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Ollama (yerel LLM) ---
OLLAMA_PORT=11434

# --- API ---
API_PORT=8000
# Virgülle ayrılmış izinli CORS kaynakları
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- UI ---
UI_PORT=3000
# Tarayıcının erişeceği API adresi (UI derlenirken gömülür)
VITE_API_URL=http://localhost:8000
